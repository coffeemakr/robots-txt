---
// Where the robots.txt to check comes from: the generator's buttons, the text box or a dropped file. app.js presses
// the buttons to match the generated block in the text box.
import { GEN_CATS } from '../lib/catalog.js';
---

<div class="panel">
  <fieldset class="gen" id="gen" aria-describedby="gennote">
    <legend class="sr">Generate a robots.txt</legend>
    <div class="gencats">
      {GEN_CATS.map(([cat, title, label = title]) => (
        <div class="gencat" role="group" aria-labelledby={`gc-${cat}`} data-cat={cat}>
          <span class="gcname" id={`gc-${cat}`}>{label}</span>
          <span class="seg">
            <button type="button" data-set="unset" aria-pressed="true">Not set</button>
            <button type="button" data-set="block" aria-pressed="false">Block</button>
            <button type="button" data-set="allow" aria-pressed="false">Allow</button>
          </span>
        </div>
      ))}
    </div>
    <p class="hint" id="gennote" style="margin-top:2px">Edits a marked block in your robots.txt below, or writes a new
      one. For single bots, click them in the table.</p>
    <p class="hint" id="genstatus" role="status"></p>
  </fieldset>
  <label for="src" style="font-weight:600">Your robots.txt</label>
  <textarea id="src" spellcheck="false" placeholder={'User-agent: *\nDisallow:'}
    aria-describedby="srchint"></textarea>
  <div class="tools">
    <button id="clr" type="button">Clear</button>
    <button id="dl" type="button">Download robots.txt</button>
  </div>
  <p class="hint" id="srchint">Updates as you type. You can also drop a file onto the box.</p>
  <p class="hint" id="srcstatus" role="status"></p>
</div>
