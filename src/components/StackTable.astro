---
// Table whose body app.js fills in. On narrow screens the .stack class stacks the cells,
// labelling each with its column heading (see the MutationObserver at the top of app.js).
type Column = string | { label: string; width: string };

interface Props {
  id: string;
  columns: Column[];
}

const { id, columns } = Astro.props;
const cols = columns.map((c) => (typeof c === 'string' ? { label: c, width: undefined } : c));
---

<table class="stack" id={id}>
  <thead>
    <tr>
      {cols.map(({ label, width }) => <th style={width && `width:${width}`}>{label}</th>)}
    </tr>
  </thead>
  <tbody></tbody>
</table>
