---
// A full-width band with a centred content column, optionally headed by an <h2>.
interface Props {
  as?: 'section' | 'header' | 'footer';
  title?: string;
  style?: string;
  wrapClass?: string;
}

const { as: Tag = 'section', title, style = 'padding-top:0', wrapClass } = Astro.props;
---

<Tag class="band" style={style}>
  <div class:list={['wrap', wrapClass]}>
    {title && <h2>{title}</h2>}
    <slot />
  </div>
</Tag>
