---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import InputPanel from '../components/InputPanel.astro';
import Legend from '../components/Legend.astro';
import StackTable from '../components/StackTable.astro';
import Notes from '../components/Notes.astro';
---

<Layout title="robots.txt AI check">
  <Section as="header" style="padding-bottom:12px">
    <h1>robots.txt AI check</h1>
    <p class="lede">Paste a robots.txt to see, for each AI company, whether training, AI search and user-requested
      fetches are blocked, partly blocked or allowed, and which named bots ignore robots.txt anyway. Or choose what to
      block or allow and get a robots.txt that does it.</p>
  </Section>

  <Section style="padding-top:12px" wrapClass="top">
    <InputPanel />
    <div style="display:flex;flex-direction:column;gap:12px">
      <div class="tiles" id="tiles"></div>
      <div class="panel">
        <h3>AI preference signals</h3>
        <div id="signals"></div>
        <p class="hint" id="sigstatus" role="status"></p>
      </div>
    </div>
  </Section>

  <Section title="By company">
    <p class="hint" id="sortnote" style="margin:-4px 0 0">Major players are sorted by share of AI referral traffic in
      2026, then alphabetically; others alphabetically.</p>
    <p class="hint" style="margin:4px 0 0">Click a bot to switch what the generated block of the robots.txt above does
      with it: block it, allow it, or leave it to the rest of the file.</p>
    <Legend />
    <p class="oleg" id="openleg"></p>
    <StackTable id="matrix" columns={['Company', 'Training', 'AI search', 'User-requested fetch']} />
  </Section>

  <Section title="User-agents named in your file">
    <StackTable
      id="named"
      columns={[{ label: 'User-agent', width: '24%' }, { label: 'Result', width: '22%' }, 'Note']}
    />
  </Section>

  <Section title="Problems found">
    <div class="panel" id="warnings"></div>
  </Section>

  <Section as="footer" wrapClass="foot">
    <Notes />
  </Section>

  <script>
    import '../scripts/app.js';
  </script>
</Layout>
